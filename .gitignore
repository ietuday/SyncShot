# =========================
# Go build files
# =========================
bin/
build/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace
go.work
go.work.sum

# Go coverage
coverage.out
*.coverprofile

# =========================
# Output folders (IMPORTANT)
# =========================
output/
output/video/
output/shorts/
output/work/

# If you want to keep folder structure but ignore files:
!output/.gitkeep
!output/video/.gitkeep
!output/shorts/.gitkeep
!output/work/.gitkeep

# =========================
# Media inputs (optional)
# =========================
inputs/audio/*
inputs/images/*

# Keep folders but ignore files
!inputs/audio/.gitkeep
!inputs/images/.gitkeep

# =========================
# Temp files
# =========================
tmp/
temp/
*.tmp
*.log

